  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 673ccc16db638bd4fb9e7881052c9c03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  dialogueCanvas: {fileID: 172623431}
  textComponent: {fileID: 183906764}
  lines:
  - "Kruk Dawian:  ...Teraz pami\u0119tam to wyra\u017Aniej. By\u0142a kwiaciark\u0105."
  - "Kruk Dawian: Rozdawa\u0142a je \u017Co\u0142nierzom na szcz\u0119\u015Bcie.
    My... rozstali\u015Bmy si\u0119 w z\u0142ych stosunkach. "
  - "Kruk Dawian: Mo\u017Cna by powiedzie\u0107, \u017Ce si\u0119 pok\u0142\xF3cili\u015Bmy.
    \u017Ba\u0142uj\u0119, \u017Ce nie rozmawia\u0142em z ni\u0105 wi\u0119cej. "
  - "Kruk Dawian: \u017Ba\u0142uj\u0119, \u017Ce by\u0142em takim idiot\u0105.  "
  - "Kruk Dawian: Nie chcia\u0142a, \u017Cebym nara\u017Ca\u0142 \u017Cycie w tak
    m\u0142odym wieku, ale ja nalega\u0142em. G\u0142upia decyzja, kt\xF3ra ostatecznie
    doprowadzi\u0142a mnie do ruiny. "
  - "Kruk Dawian: Wr\xF3ci\u0142em po jednej z bitew... Jedyne, co po niej pozosta\u0142o,
    to zakrwawione kwiaty, kt\xF3rymi kiedy\u015B si\u0119 opiekowa\u0142a."
  textSpeed: 10
  index: 0
  dialogueEnded: 1
  reward: {fileID: 0}
  dEnded: 1
